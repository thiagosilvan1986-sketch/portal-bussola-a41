# Copie para .env e preencha com os dados do app da Web no console do Firebase
# (Configurações do projeto > Seus apps > App da Web > Configuração do SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Avisos de vencimento com o app fechado. Fica SÓ no painel do Netlify (Project configuration > Environment variables),
# marcada como secret, nunca com prefixo VITE_ e nunca no repositório. Para testar localmente com `netlify dev`, use um .env que não vai ao Git.
# FIREBASE_SERVICE_ACCOUNT=      # conteúdo do JSON da conta de serviço do Firebase (puro ou em base64)
# VAPID_PUBLIC_KEY=              # opcional: se faltar, o servidor cria o par sozinho e guarda no Firestore
# VAPID_PRIVATE_KEY=             # opcional (junto com a pública)
# VAPID_SUBJECT=                 # opcional: contato exigido pelos serviços de notificação (padrão: o endereço do site)
