# Copie para .env e preencha com os dados do app da Web no console do Firebase
# (Configurações do projeto > Seus apps > App da Web > Configuração do SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Fase 2 (leitura do Gmail). Estas ficam SÓ no painel do Netlify (Project configuration > Environment variables),
# nunca com prefixo VITE_ e nunca no repositório. Para testar localmente com `netlify dev`, coloque num .env que não vai ao Git.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_STATE_SECRET=            # texto aleatório longo (assina o retorno do login do Google)
# ANTHROPIC_API_KEY=
# FIREBASE_SERVICE_ACCOUNT=      # conteúdo do JSON da conta de serviço do Firebase
# APP_URL=                       # opcional: https://appfinancasbr.netlify.app
# ANTHROPIC_MODEL=               # opcional: troca o modelo (padrão claude-haiku-5-5)
